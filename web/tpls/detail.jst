{{#def.parts}}
{{#def.header:{rootPath:it.rootPath || '',title:it.tbName+'详情'} }}
{{#def.main:{rootPath:it.rootPath || ''} }}
<div class="ui-container">
  <div class="ui-card">
    <div class="page-header">
      <h3 class="page-title">{{=it.tbName}}详情</h3>
      <div class="page-actions">
        <button class="ui-button" id="btn-back">返回列表</button>
        <button class="ui-button" id="btn-cancel" style="display: none;">取消</button>
        <button class="ui-button primary" id="btn-modify" style="display:none;">修改</button>
        <button class="ui-button danger" id="btn-del" data-loading-text="删除中..." style="display:none;">删除</button>
        <button class="ui-button primary" id="btn-save" data-loading-text="更新中..." sstyle="display: none;">保存</button>
        {{=it.moreButton || ''}}
      </div>
    </div>
    <hr class="ui-divider">
    <div id="detail-container">
      <!-- 表单将动态生成在这里 -->
      <form id="detail-form" class="view-mode">
        <div class="detail-form-grid"></div>
      </form>
    </div>
  </div>
</div>
<input type="hidden" name="tb" id="tb" value="{{=it.tb}}" />
<input type="hidden" name="tbid" id="tbid" value="{{=it.id}}" />
{{#def.footer:{rootPath:it.rootPath || '',tb:it.tb,scripts:'<script src="'+(it.rootPath || '')+'js/detail.js"></script>'+(it.moreJS||'')} }}