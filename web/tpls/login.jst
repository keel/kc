{{#def.parts}}
{{#def.header:{title:"登录入口"} }}
<div class="login_wrapper">
  <div class="ui-card login-card">
    <h1>后台管理系统</h1>
    <form id="login-form">
      <div class="ui-form-item">
        <label for="loginName">用户名</label>
        <input type="text" id="loginName" class="ui-input" required>
      </div>
      <div class="ui-form-item">
        <label for="loginPwd">密码</label>
        <input type="password" id="loginPwd" class="ui-input" required>
      </div>
      <div class="ui-form-item">
        <button type="submit" id="bt_submit" class="ui-button primary" data-loading-text="验证中..." style="width: 100%;">登录</button>
      </div>
    </form>
  </div>
</div>
<script>
$(document).ready(function() {
  $('#bt_submit').on('click', function(e) {
    e.preventDefault();
    //这里简单化处理
    var loginName = $('#loginName').val();
    var loginPwd = $('#loginPwd').val();
    if (!loginName || !loginPwd) {
      AdminUI.removeLoading('#bt_submit');
      AdminUI.toast('请完整填写用户名和密码', 'danger');
      return;
    }
    kc.jPost('login', { 'u': kc.base64(loginName), 'p': kc.base64(loginPwd) }, function(err, re) {
      AdminUI.removeLoading('#bt_submit');
      if (re.code !== 0) {
        AdminUI.popWin.alert('登录失败.' + re.data);
        return;
      }
      AdminUI.toast('登录成功, 正在跳转...', 'success');
      window.location.href = 'main';
    });
  });
});
</script>
</body>

</html>