{{#def.parts}}
{{#def.header:{rootPath:it.rootPath || '',title:"主页"} }}
{{#def.main:{rootPath:it.rootPath || ''} }}
<div class="ui-container">
  <div class="ui-card" style="margin-bottom: 24px;">
    <h3>公告</h3>
    <p style="margin-top: 10px; color: var(--text-color-2);">欢迎使用管理系统</p>
  </div>
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px;">
    <div class="ui-card">
      <h3>测试</h3>
      <div>
        <button id="bt1" class="ui-button danger">按钮1</button>
        <button class="ui-button primary">按钮2</button>
      </div>
      <p></p>
      <div>
        <br />
        <br />
        <select data-ui-multiselect multiple>
          <option value="1">选项1</option>
          <option value="2">选项2</option>
          <option value="3">选项3</option>
          <option value="4">选项4</option>
        </select>
        <p></p>
        <br />
        <br />
        <select data-ui-select>
          <option value="1">单选项1</option>
          <option value="2">单选项2</option>
          <option value="3">单选项3</option>
          <option value="4">单选项4</option>
        </select>
        <br />
        <br />
        <br />
        <div class="form-control-edit">
          <div class="ui-form-item">
            <label>性别选择</label>
            <div>
              <label class="ui-radio">
                <input type="radio" name="gender" value="male" checked>
                <span class="circle"></span>
                <span>男</span>
              </label>
              <label class="ui-radio">
                <input type="radio" name="gender" value="female">
                <span class="circle"></span>
                <span>女</span>
              </label>
              <label class="ui-radio">
                <input type="radio" name="gender" value="other">
                <span class="circle"></span>
                <span>其他</span>
              </label>
            </div>
          </div>
        </div>
        <br />
        <div id="upload-area"></div>
      </div>
    </div>
    <div class="ui-card">
      <h3>测试</h3>
      <div>
        <!-- DatePicker 示例 -->
        <div class="ui-form-item">
          <label for="event-date">活动日期</label>
          <!-- 只需添加 data-ui-datepicker 属性即可自动初始化 -->
          <input type="text" id="event-date" class="ui-input" data-ui-datepicker placeholder="请选择日期">
        </div>
        <hr class="ui-divider-text"><span>Tree 控件示例</span></hr>
        <!-- Tree 示例 -->
        <div class="ui-form-item">
          <label>分配权限 (带复选框)</label>
          <!-- 这是树形控件的容器 -->
          <div id="permission-tree" class="ui-card" style="padding: 10px; max-height: 250px; overflow-y: auto;">
            <!-- Tree 将被JS渲染到这里 -->
          </div>
          <button id="get-checked-btn" class="ui-button primary" style="margin-top: 15px;">获取选中项</button>
        </div>
        <div class="ui-form-item">
          <label>文件目录 (仅展示)</label>
          <!-- 另一个树形控件容器 -->
          <div id="file-tree" class="ui-card" style="padding: 10px; ">
            <!-- Tree 将被JS渲染到这里 -->
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
{{#def.footer:{rootPath:it.rootPath || '',link:'main',scripts:'<script src="'+(it.rootPath || '')+'js/main.js"></script>'} }}