{{#def.parts}}
{{#def.header:{rootPath:it.rootPath || '',title:it.tbName+'列表', rootPath:it.rootPath || ''} }}
{{#def.main:{rootPath:it.rootPath || '',title:"Console",userName:'admin'} }}
<div class="ui-container">
  <!-- 搜索/过滤卡片 -->
  <div class="ui-card" style="margin-bottom: 24px;">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px;">
      <h3 class="page-title" id="tableTitle">{{=it.tbName}}列表</h3>
      <div style="display: flex; gap: 10px;">
        <button class="ui-button primary" id="search-btn">查询</button>
        <button class="ui-button primary" id="add-btn">新增</button>
        {{=it.moreButton || ''}}
      </div>
    </div>
    <hr class="ui-divider">
    <div id="tableSearch" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px;">
    </div>
  </div>
  <!-- 列表卡片 -->
  <div class="ui-card" id="list-container">
    <div class="ui-table-container" id="listTable">
    </div>
    <!-- 分页容器 -->
    <div id="pagination-container" class="ui-pagination"></div>
  </div>
</div>
<input type="hidden" name="tb" id="tb" value="{{=it.tb}}" />
{{#def.footer:{rootPath:it.rootPath || '',tb:it.tb,scripts:'<script src="'+(it.rootPath || '')+'js/list.js"></script>'+(it.moreJS||'')} }}