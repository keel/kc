{{#def.parts}}
{{#def.header:{title:"列表页"} }}
{{#def.main:{title:"Console",userName:'admin'} }}
<div class="ui-container">
  <div class="ui-card">
    <div class="page-header">
      <h3 class="page-title">详情</h3>
      <div class="page-actions">
        <button class="ui-button" id="btn-back">返回列表</button>
        <button class="ui-button" id="btn-cancel" style="display: none;">取消</button>
        <button class="ui-button primary" id="btn-modify">修改</button>
        <button class="ui-button primary" id="btn-save" style="display: none;">保存</button>
      </div>
    </div>
    <hr class="ui-divider">
    <div id="detail-container">
      <!-- 表单将动态生成在这里 -->
      <form id="detail-form" class="view-mode">
        <div class="detail-form-grid"></div>
      </form>
    </div>
  </div>
</div>

{{#def.footer:{scripts:'<script src="'+(it.rootPath || '')+'js/detail.js"></script>'} }}